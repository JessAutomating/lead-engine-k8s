# Copy this file to .env and fill in REAL values to run against live services.
# .env is gitignored and must never be committed. In Kubernetes these become a
# Secret (the API keys) and a ConfigMap (the non-secret IDs and addresses).
#
# In --dry-run mode NONE of these are required: the runner uses local fixtures
# and makes zero network calls, so you can test the full pipeline with no spend.

# --- Secrets (Kubernetes Secret) ---
APIFY_TOKEN=replace-with-apify-token
FIRECRAWL_API_KEY=replace-with-firecrawl-key
ANTHROPIC_API_KEY=replace-with-anthropic-key
# Single OAuth access token with Sheets + Gmail scopes (short lived).
# For a long running job, mint this from a service account or refresh token.
GOOGLE_ACCESS_TOKEN=replace-with-google-oauth-access-token

# --- Non-secret config (Kubernetes ConfigMap) ---
GOOGLE_SHEET_ID=replace-with-spreadsheet-id
NOTIFY_TO=operator@example.com
NOTIFY_FROM=lead-engine@example.com
